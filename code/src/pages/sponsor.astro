---
import Base from '../layouts/Base.astro';
const title = 'Sponsor a listing — web3-discover';
const description = 'Reach airdrop hunters directly. One Featured slot, visually distinct, never confused with our organic listings. Pricing and contact below.';
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <div class="kicker">For projects</div>
      <h1>Sponsor a Featured slot</h1>
      <p class="lede">
        web3-discover reaches retail users who already know what an airdrop is and are
        actively looking for the next one to farm. If your launch needs eyeballs from
        that exact audience, the Featured slot at the top of <a href="/airdrops">/airdrops</a>
        is for sale.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="prose">
        <h2>The offer</h2>
        <ul>
          <li><strong>One slot</strong> at the top of the index. Visually distinct (separate background + a clear "Sponsored" label). Never disguised as organic.</li>
          <li><strong>Per-project page</strong> with the same structured fields as our organic listings — action, effort, cost floor, deadline, risk flag, official link. We write the copy; you approve before publish.</li>
          <li><strong>Cross-link</strong> from any related listing where contextually honest.</li>
          <li><strong>One social post</strong> from the web3-discover account at launch, clearly labelled <code>#sponsored</code>.</li>
        </ul>

        <h2>What we won't do</h2>
        <ul>
          <li>Change a project's <strong>risk flag</strong> for money. Verified means verified; suspect means suspect.</li>
          <li>Hide the sponsorship. Every paid slot carries the <em>Sponsored</em> label and links to <a href="/disclosure">our disclosure</a>.</li>
          <li>List a project we wouldn't farm ourselves. We reserve the right to decline.</li>
        </ul>

        <h2>Pricing</h2>
        <p>
          <strong>$400 / week</strong> introductory rate while we're growing baseline traffic.
          Revised every 30 days as the audience grows — early sponsors keep their original rate
          for a 90-day window. Payable in USDC, USDT (ETH/Solana/Base), or USD via invoice.
        </p>

        <h2>Contact</h2>
        <p>
          Email <a href="mailto:sponsorship@west0n.top"><strong>sponsorship@west0n.top</strong></a>
          with: project name, official URL, the airdrop or campaign you want to feature,
          desired start week, and any past traction signals (Twitter, Discord, docs).
          Expect a reply within ~24 hours.
        </p>

        <h2>FAQ</h2>
        <h3>Do you require KYC of the sponsor?</h3>
        <p>No. We do require a working official URL, public Twitter handle, and a coherent
        whitepaper / docs page. If something feels off, we walk away.</p>

        <h3>Can you guarantee impressions?</h3>
        <p>No. We publish honest traffic numbers monthly on this page once we have meaningful
        baseline data. If your slot underperforms a published baseline, we offer a pro-rated
        credit.</p>

        <h3>Can I sponsor and stay anonymous?</h3>
        <p>No. Sponsored listings carry the same identifying fields as organic ones — that's
        the point of the disclosure standard.</p>
      </div>
    </div>
  </section>
</Base>
