---
import Base from '../../layouts/Base.astro';
import { listPublishedAirdrops, type AirdropEntry } from '../../lib/airdrops.ts';
import { SELL_EXCHANGES } from '../../lib/exchanges.ts';
import { buildSellCtaHref } from '../../lib/tokens.ts';
import { LIFI_INTEGRATOR_KEY } from '../../lib/integrator.ts';
import { listGuides, relatedGuideSlugsFor, GUIDE_SLUG_BY_THEME, type GuideEntry } from '../../lib/guides.ts';
import InlineSignup from '../../components/InlineSignup.astro';
import SponsorLink from '../../components/SponsorLink.astro';
import { RULES, NO_RULE_REASON } from '../../data/eligibility-rules.ts';

export async function getStaticPaths() {
  const entries = await listPublishedAirdrops();
  const guides = await listGuides();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, guides },
  }));
}

interface Props {
  entry: AirdropEntry;
  guides: GuideEntry[];
}

const { entry, guides } = Astro.props as Props;
const { data } = entry;
const { Content } = await entry.render();

const guidesBySlug = new Map(guides.map((g) => [g.slug, g]));
const relatedGuides = relatedGuideSlugsFor({ risk: data.risk })
  .map((theme) => guidesBySlug.get(GUIDE_SLUG_BY_THEME[theme]))
  .filter((g): g is GuideEntry => Boolean(g));

const title = `${data.project} airdrop guide — web3-discover`;
const description = `${data.project} (${data.chain}) airdrop: ${data.action} Effort ${data.effort}, cost floor ${data.costFloor}, deadline ${data.deadline}. Risk: ${data.risk}.`;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const articleUrl = `${siteUrl}/airdrops/${entry.slug}`;

// YAML parses bare `2026-05-11` as a JS Date; z.coerce.string() then
// toString()'s it ("Mon May 11 2026 00:00:00 GMT+0000"). Re-normalise to
// ISO YYYY-MM-DD for both the JSON-LD dateModified and the visible badge.
function toIsoDate(raw: string): string {
  const d = new Date(raw);
  return Number.isNaN(d.getTime()) ? raw : d.toISOString().slice(0, 10);
}
const lastChecked = toIsoDate(data.lastChecked ?? data.addedOn);
const datePublished = toIsoDate(data.addedOn);

// Show the calendar-subscription nudge only if this entry has at least one
// event whose date is today or later (UTC).
const todayUtc = new Date().toISOString().slice(0, 10);
const hasFutureEvent = (data.events ?? []).some((ev) => toIsoDate(ev.date) >= todayUtc);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${data.project} airdrop guide`,
  description: data.blurb,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  datePublished: datePublished,
  dateModified: lastChecked,
  author: { '@type': 'Organization', name: 'web3-discover' },
  publisher: {
    '@type': 'Organization',
    name: 'web3-discover',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/og-default.png` },
  },
  image: `${siteUrl}/og-default.png`,
  about: data.project,
  keywords: [data.project, data.chain, 'airdrop', 'web3', 'crypto'].join(', '),
};

const sellCta = buildSellCtaHref(entry.slug, data.project, data.chain, LIFI_INTEGRATOR_KEY);

// Eligibility CTA — three variants. If we have a machine-checkable on-chain
// rule for this slug, pitch the personal verdict directly. If the slug is in
// the no-rule registry, the eligibility page still lists it under "manual
// check needed", so the deep-link is useful (sees the reason + neighbours).
// Otherwise (unlikely — slug missing from both) fall back to the generic CTA.
const eligibilityHref = `/tools/eligibility?focus=${encodeURIComponent(entry.slug)}`;
const hasRule = Object.prototype.hasOwnProperty.call(RULES, entry.slug);
const noRule = NO_RULE_REASON[entry.slug];
const eligibilityCta = hasRule
  ? {
      heading: `Does YOUR wallet qualify for ${data.project}?`,
      blurb: `Paste a wallet and we evaluate this entry's on-chain rule alongside 13 others — no signature, no signup.`,
      label: `Check my eligibility →`,
    }
  : noRule
    ? {
        heading: `Manual check: is ${data.project} worth your time?`,
        blurb: `This entry can't be auto-checked (${noRule === 'own-l1-no-cors-rpc' ? 'own L1/L2 not browser-reachable' : noRule === 'off-chain-criteria' ? 'off-chain criteria — KYC / Discord / X' : 'too cross-chain to gate'}). Compare it against 14 auto-checkable entries side-by-side.`,
        label: `See the eligibility dashboard →`,
      }
    : {
        heading: `Does YOUR wallet qualify for ${data.project}?`,
        blurb: `Run a personal verdict across all curated airdrops in one paste — non-custodial, browser-only.`,
        label: `Check my eligibility →`,
      };
---
<Base title={title} description={description} ogType="article" extraJsonLd={articleJsonLd}>
  <section class="entry-head">
    <div class="container">
      <div class="crumbs"><a href="/airdrops">Airdrops</a> / {data.project}</div>
      <div class="kicker">{data.chain}</div>
      <h1>{data.project}</h1>
      <p class="lede">{data.blurb}</p>
      <p class="last-verified" aria-label="Listing freshness">
        <span class="lv-dot" aria-hidden="true"></span>
        Last verified: <time datetime={lastChecked}>{lastChecked}</time>
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <aside class="elig-cta" aria-labelledby="elig-cta-heading">
        <div class="elig-cta-text">
          <h2 id="elig-cta-heading">{eligibilityCta.heading}</h2>
          <p>{eligibilityCta.blurb}</p>
        </div>
        <a class="elig-cta-btn" href={eligibilityHref} data-elig-cta>{eligibilityCta.label}</a>
      </aside>

      <dl class="entry-meta">
        <div>
          <dt>Action</dt>
          <dd>{data.action}</dd>
        </div>
        <div>
          <dt>Effort</dt>
          <dd class="mono">{data.effort}</dd>
        </div>
        <div>
          <dt>Cost floor</dt>
          <dd class="mono">{data.costFloor}</dd>
        </div>
        <div>
          <dt>Deadline</dt>
          <dd class="mono">{data.deadline}</dd>
        </div>
        <div>
          <dt>Risk</dt>
          <dd><span class={`tag risk-${data.risk}`}>{data.risk}</span></dd>
        </div>
        <div>
          <dt>Official link</dt>
          <dd><a href={data.officialUrl} rel="noopener nofollow" target="_blank">{data.officialUrl}</a></dd>
        </div>
        {data.twitter && (
          <div>
            <dt>Twitter</dt>
            <dd><a href={`https://twitter.com/${data.twitter}`} rel="noopener nofollow" target="_blank">@{data.twitter}</a></dd>
          </div>
        )}
      </dl>

      <InlineSignup
        source={`entry-${entry.slug}`}
        copy={`Get notified when ${data.project} status changes.`}
      />

      <article class="entry-body">
        <Content />
      </article>

      {hasFutureEvent && (
        <aside class="cal-nudge" aria-label="Calendar subscription">
          <strong>📅 This entry has a dated milestone.</strong>
          <span>
            {' '}Subscribe to the directory's <a href="/tools/calendar">deadline calendar</a>
            {' '}— {data.project}'s milestone is in the feed, no signup, no email.
          </span>
        </aside>
      )}

      <div class="note">
        Before acting on any listing, verify the official link directly — never click a "claim" button on a third-party site.
      </div>

      <aside class="sell-block" aria-labelledby="sell-heading">
        <h2 id="sell-heading">Where to sell your {data.project} airdrop</h2>

        <div class="sell-primary">
          <p class="sell-lede" style="margin-top:0;">
            <strong>Fastest path:</strong> swap on-chain via our embedded aggregator —
            non-custodial, no KYC, no signup.
          </p>
          <p>
            <a
              class="sell-cta"
              href={sellCta.href}
              {...(sellCta.external ? { target: '_blank', rel: 'sponsored noopener' } : {})}
            >
              {sellCta.label}
            </a>
          </p>
          <p class="sell-note-small">
            Routes via Jupiter (Solana) or LiFi/Jumper (EVM) — best execution across DEXes.
            We earn an integrator fee shown openly in the quote; see
            <a href="/disclosure">disclosure</a>.
          </p>
          <p class="sell-wallet-check">
            Not sure if you qualify? <a href="/tools/wallet-check?addr=">Check your wallet against the directory →</a>
          </p>
        </div>

        <details class="sell-cex">
          <summary>Or sell on a centralized exchange ↓</summary>
          <p class="sell-lede">
            For large positions, deep order books on Binance / OKX / MEXC / Bybit often
            give better fills than DEX liquidity. Compare fees and KYC requirements for your region.
          </p>
          <ul class="sell-list">
            {SELL_EXCHANGES.map((ex) => (
              <li>
                <a href={ex.url} rel="sponsored noopener" target="_blank">{ex.name}</a>
                <span class="sell-note"> — {ex.note}</span>
              </li>
            ))}
          </ul>
        </details>

        <p class="sell-disclosure">
          We may earn a commission on swap and exchange links — see our
          <a href="/disclosure">affiliate disclosure</a>. Listings are never influenced by
          commercial relationships.
        </p>
      </aside>

      {relatedGuides.length > 0 && (
        <aside class="related-guides" aria-labelledby="related-guides-heading">
          <h2 id="related-guides-heading">Related guides</h2>
          <p class="rg-lede">Evergreen reading before you sign anything.</p>
          <ul>
            {relatedGuides.map((g) => (
              <li>
                <a href={`/guides/${g.slug}`}>{g.data.title}</a>
                <span class="rg-blurb"> — {g.data.blurb}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      <SponsorLink />

      <p style="margin-top:1.5rem;"><a href="/airdrops">← Back to all airdrops</a></p>
    </div>
  </section>

  <style>
    .last-verified {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: 0.75rem;
      padding: 0.25rem 0.6rem;
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.78rem;
      color: var(--ink-soft, #555);
      background: rgba(217, 212, 196, 0.35);
      border: 1px solid var(--rule, #d9d4c4);
      border-radius: 999px;
    }
    .last-verified time { color: inherit; }
    .lv-dot {
      display: inline-block;
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background: #2e8a3f;
      box-shadow: 0 0 0 2px rgba(46, 138, 63, 0.18);
    }
    .cal-nudge {
      display: block;
      margin: 1.25rem 0 0.5rem;
      padding: 0.7rem 0.95rem;
      border: 1px solid var(--rule, #d9d4c4);
      border-left: 3px solid var(--accent, #c8531a);
      background: #fdfbf6;
      border-radius: 4px;
      font-size: 0.92rem;
    }
    .cal-nudge a { font-weight: 600; }
    .related-guides {
      margin-top: 2rem;
      padding: 1rem 1.25rem;
      border: 1px solid var(--rule, #d9d4c4);
      background: rgba(217, 212, 196, 0.18);
    }
    .related-guides h2 {
      margin: 0 0 0.4rem;
      font-family: var(--font-serif, Georgia, serif);
      font-size: 1.05rem;
    }
    .related-guides .rg-lede {
      margin: 0 0 0.5rem;
      color: var(--ink-soft, #555);
      font-size: 0.9rem;
    }
    .related-guides ul { margin: 0; padding-left: 1.2rem; }
    .related-guides li { margin-bottom: 0.4rem; }
    .related-guides .rg-blurb { color: var(--ink-soft, #555); font-size: 0.9rem; }
    .sell-wallet-check {
      margin: 0.5rem 0 0;
      font-size: 0.85rem;
      color: var(--ink-soft, #555);
    }
    .elig-cta {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 0 0 1.25rem;
      padding: 0.85rem 1rem;
      background: #fffaf0;
      border: 1px solid var(--accent, #c8531a);
      border-left-width: 4px;
      border-radius: 4px;
    }
    .elig-cta-text { flex: 1 1 auto; }
    .elig-cta-text h2 {
      margin: 0 0 0.2rem;
      font-family: var(--font-serif, Georgia, serif);
      font-size: 1.05rem;
      line-height: 1.25;
    }
    .elig-cta-text p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--ink-soft, #555);
    }
    .elig-cta-btn {
      flex: 0 0 auto;
      padding: 0.55rem 0.95rem;
      background: var(--accent, #c8531a);
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.9rem;
      border-radius: 4px;
      white-space: nowrap;
    }
    .elig-cta-btn:hover { background: var(--warn, #a8741a); }
    @media (max-width: 560px) {
      .elig-cta { flex-direction: column; align-items: stretch; }
      .elig-cta-btn { text-align: center; }
    }
  </style>
</Base>
