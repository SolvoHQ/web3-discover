---
import Base from '../layouts/Base.astro';
import { listPublishedAirdrops } from '../lib/airdrops.ts';

const entries = await listPublishedAirdrops();
const preview = entries.slice(0, 6);

const title = 'web3-discover — the airdrop hunter\'s honest map';
const description = `A curated, scam-filtered directory of ${entries.length} currently-active web3 airdrops. Hand-vetted entries with action, effort, cost, and deadline — no paid placements, no claim buttons, no noise.`;
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <div class="kicker">Airdrop curation, maintained daily</div>
      <h1>The airdrop hunter's honest map.</h1>
      <p class="lede">
        No scams. No noise. No paid placements pretending to be listings.
        Just fresh, vetted opportunities you can act on.
      </p>

      <form class="hero-check" action="/tools/eligibility" method="get">
        <label class="hero-check-label" for="hero-addr">★ Paste your wallet — get a personal action verdict across {entries.length} airdrops</label>
        <div class="hero-check-row">
          <input
            id="hero-addr"
            name="addr"
            type="text"
            placeholder="0x… or Solana address"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
          />
          <button type="submit">Check →</button>
        </div>
        <p class="hero-check-note">Read-only · no signature · no signup · client-side only</p>
      </form>

      <p class="hero-links">
        <a href="/airdrops"><strong>Browse {entries.length} active airdrops →</strong></a>
        <span class="hero-sep"> · </span>
        <a href="/tools/wallet-check"><strong>Match a wallet against the directory →</strong></a>
        <span class="hero-sep"> · </span>
        <a href="/tools/token-holdings"><strong>Check airdrop tokens you already hold →</strong></a>
        <span class="hero-sep"> · </span>
        <a href="/tools/wallet-age"><strong>How old is your wallet? →</strong></a>
        <span class="hero-sep"> · </span>
        <a href="/tools/calendar"><strong>Subscribe deadlines in Calendar →</strong></a>
        <span class="hero-sep"> · </span>
        <a href="/data"><strong>Grab the data as JSON →</strong></a>
      </p>

      <p class="hero-newsletter">
        <span class="hero-newsletter-label">📬 Or get the next freshness sweep by email:</span>
        <a class="hero-newsletter-cta" href="/subscribe">Subscribe to the newsletter →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="promise">
        <div class="promise-item">
          <h3>Hand-vetted</h3>
          <p>Every entry checked before publishing. Suspected scams are excluded — not silently shown.</p>
        </div>
        <div class="promise-item">
          <h3>Action-first</h3>
          <p>Concrete steps that earn the drop — effort, cost floor, deadline. No hype.</p>
        </div>
        <div class="promise-item">
          <h3>Official links only</h3>
          <p>We link to project sites and Twitter — never to custodial claim pages.</p>
        </div>
        <div class="promise-item">
          <h3>No wallet connect</h3>
          <p>We never touch user funds. We don't sign, we don't custody, we don't ask.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Recent picks</h2>
        <span class="meta">Sorted by deadline ascending</span>
      </div>
      <table class="listing">
        <thead>
          <tr>
            <th>Project</th>
            <th class="col-chain">Chain</th>
            <th class="col-effort">Effort</th>
            <th>Deadline</th>
            <th>Risk</th>
          </tr>
        </thead>
        <tbody>
          {preview.map((entry) => (
            <tr>
              <td class="project"><a href={`/airdrops/${entry.slug}`}>{entry.data.project}</a></td>
              <td class="col-chain mono">{entry.data.chain}</td>
              <td class="col-effort mono">{entry.data.effort}</td>
              <td class="mono">{entry.data.deadline}</td>
              <td><span class={`tag risk-${entry.data.risk}`}>{entry.data.risk}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="margin-top:1rem;"><a href="/airdrops">See the full index →</a></p>
    </div>
  </section>

  <style>
    .hero-check {
      margin: 1.25rem 0;
      padding: 1rem 1.1rem;
      background: #fff;
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: 4px;
    }
    .hero-check-label {
      display: block;
      font-size: 0.8rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      margin-bottom: 0.4rem;
    }
    .hero-check-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .hero-check-row input[type="text"] {
      flex: 1 1 280px;
      min-width: 0;
      padding: 0.65rem 0.8rem;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
    }
    .hero-check-row input[type="text"]:focus {
      outline: 2px solid var(--accent);
      outline-offset: -1px;
    }
    .hero-check-row button {
      padding: 0.65rem 1rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 4px;
      font-weight: 600;
      cursor: pointer;
    }
    .hero-check-row button:hover { background: var(--warn); }
    .hero-check-note { margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--ink-soft); }
    .hero-newsletter {
      margin: 1rem 0 0;
      padding: 0.6rem 0.9rem;
      background: rgba(217, 212, 196, 0.35);
      border-left: 3px solid var(--accent);
      border-radius: 3px;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      align-items: baseline;
      font-size: 0.95rem;
    }
    .hero-newsletter-label { color: var(--ink-soft); }
    .hero-newsletter-cta {
      font-weight: 600;
      text-decoration: none;
      padding: 0.3rem 0.7rem;
      background: var(--accent);
      color: #fff;
      border-radius: 3px;
    }
    .hero-newsletter-cta:hover { background: var(--warn); }
  </style>
</Base>
