---
import Base from '../../layouts/Base.astro';
import LifiSwapWidget from '../../components/LifiSwapWidget.tsx';
import {
  EVM_INTEGRATOR_ADDRESS,
  SOL_INTEGRATOR_ADDRESS,
  LIFI_INTEGRATOR_KEY,
  LIFI_FEE_BPS,
} from '../../lib/integrator.ts';
import { SOLANA_MINTS, SLUG_SWAP_TARGETS, JUMPER_CHAIN_KEYS } from '../../lib/tokens.ts';

const title = 'Swap airdrop tokens — web3-discover';
const description = 'Embedded LiFi DEX aggregator. EVM and Solana swaps both route through the same widget. Honest 30 bps integrator fee disclosed upfront. No KYC, no signup, non-custodial.';
const lifiFeePct = (LIFI_FEE_BPS / 100).toFixed(2);
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <div class="kicker">Tools</div>
      <h1>Swap your airdrop tokens.</h1>
      <p class="lede">
        Non-custodial, no signup, no KYC. Both Solana and EVM swaps route through the same embedded
        <a href="https://li.fi" rel="noopener" target="_blank">LiFi</a> widget
        (the router that also powers <a href="https://jumper.exchange" rel="noopener" target="_blank">jumper.exchange</a>).
        We earn an integrator fee of <strong>{lifiFeePct}%</strong> on swaps initiated here —
        disclosed openly, baked into the quote you see (EVM live; Solana live). See our
        <a href="/disclosure">affiliate disclosure</a>.
      </p>
      <div id="preselect-banner" class="preselect-banner" hidden></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 id="solana">Solana — LiFi widget</h2>
      <p class="muted">
        Routed via LiFi (which dispatches across Jupiter, OKX DEX, and other Solana aggregators
        per quote). Connect Phantom / Solflare / any Solana wallet, pick tokens, swap. Our SVM
        integrator address is baked into the quote:
        <code data-integrator="solana">{SOL_INTEGRATOR_ADDRESS}</code>. The
        <strong>{lifiFeePct}%</strong> integrator fee appears as a line item in the quote and is
        auto-forwarded to the address above.
      </p>

      <div class="lifi-host">
        <LifiSwapWidget client:only="react" defaultChainId={1151111081099710}>
          <div slot="fallback" class="terminal-fallback">Loading LiFi widget (Solana)…</div>
        </LifiSwapWidget>
      </div>

      <p class="micro">
        Prefer a Solana-only UI? Use <a href="https://jup.ag/swap/SOL-USDC" rel="noopener" target="_blank">jup.ag</a> directly —
        same routing, no integrator fee on that path.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 id="evm">EVM — LiFi widget</h2>
      <p class="muted">
        Cross-chain aggregator across Ethereum, Arbitrum, Base, Optimism, Polygon, BSC, +20 more.
        Integrator key <code data-integrator="evm-key">{LIFI_INTEGRATOR_KEY}</code>,
        EVM fee recipient <code data-integrator="evm">{EVM_INTEGRATOR_ADDRESS}</code>.
        Connect any EVM wallet (MetaMask / WalletConnect / Coinbase), pick tokens, swap —
        the <strong>{lifiFeePct}%</strong> integrator fee appears as a line item in the quote
        and is auto-forwarded by LiFi's FeeForwarder contract.
      </p>

      <div class="lifi-host">
        <LifiSwapWidget client:only="react">
          <div slot="fallback" class="terminal-fallback">Loading LiFi widget…</div>
        </LifiSwapWidget>
      </div>

      <p class="micro">
        Prefer the standalone UI? Use <a href="https://jumper.exchange" rel="noopener" target="_blank">jumper.exchange</a> directly —
        same LiFi router under the hood, no integrator fee on that path.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How the fee works (plain English)</h2>
      <div class="prose">
        <ul>
          <li>
            <strong>Solana swaps via LiFi:</strong> our integrator account is registered with
            <a href="https://portal.li.fi/integrations" rel="noopener" target="_blank">portal.li.fi</a>
            with a Solana fee-recipient (<code>{SOL_INTEGRATOR_ADDRESS}</code>) whitelisted as
            "Default SVM". On every Solana quote LiFi attributes <strong>{lifiFeePct}%</strong> to
            <code>integrator=web3-discover</code> in the swap transaction itself and forwards it
            to the SVM address above — no claim step, no PDA setup. Under the hood LiFi dispatches
            to Jupiter, OKX DEX, and other Solana aggregators based on best execution.
          </li>
          <li>
            <strong>EVM swaps via LiFi:</strong> our integrator account
            (key <code>{LIFI_INTEGRATOR_KEY}</code>, EVM recipient <code>{EVM_INTEGRATOR_ADDRESS}</code>)
            is registered with the LiFi Partner Portal — fee dashboard at
            <a href="https://portal.li.fi/integrations" rel="noopener" target="_blank">portal.li.fi/integrations</a>.
            The widget embedded above charges <strong>{lifiFeePct}%</strong> of the
            from-amount, deducted by LiFi's router during the swap transaction itself
            and forwarded to the address above by LiFi's FeeForwarder contract on
            supported chains (Ethereum, Arbitrum, Base, Optimism, Polygon, BSC, +20 more).
            Static jumper.exchange deeplinks earn 0 bps — true of every major EVM
            aggregator — so the widget embed is the only path to fee accrual.
          </li>
          <li>
            <strong>You always see the fee in the quote.</strong> Neither Jupiter nor LiFi
            hides integrator fees — the quote ("you receive X") already nets out the fee.
            If a hidden fee ever appears, that's a bug; email
            <a href="mailto:hello@west0n.top">hello@west0n.top</a> and we'll refund.
          </li>
          <li>
            <strong>Non-custodial.</strong> We never touch your tokens. The transaction is
            signed from your wallet and broadcast directly. Our address only receives the
            small integrator-fee portion.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <script
    is:inline
    type="application/json"
    id="swap-registry"
    set:html={JSON.stringify({
      solanaMints: SOLANA_MINTS,
      slugTargets: SLUG_SWAP_TARGETS,
      jumperChains: JUMPER_CHAIN_KEYS,
      lifiKey: LIFI_INTEGRATOR_KEY,
    })}
  ></script>
  <script is:inline>
    (function () {
      const registryEl = document.getElementById('swap-registry');
      if (!registryEl) return;
      let registry;
      try { registry = JSON.parse(registryEl.textContent || '{}'); } catch { return; }
      const slugTargets = registry.slugTargets || {};
      const solanaMints = registry.solanaMints || {};
      const jumperChains = registry.jumperChains || {};
      const params = new URLSearchParams(window.location.search);
      const slug = params.get('slug');
      const token = params.get('token');
      const chain = params.get('chain');

      let label = null;
      let kind = null;
      if (slug && slugTargets[slug]) {
        const t = slugTargets[slug];
        kind = t.kind;
        label = t.tokenLabel || t.chainLabel || t.symbol || slug;
      } else if (token && solanaMints[token.toUpperCase().trim()]) {
        kind = 'solana';
        label = token.toUpperCase().trim();
      } else if (chain) {
        const lower = chain.toLowerCase();
        if (/\bsolana\b/.test(lower)) {
          kind = 'solana';
          label = 'Solana';
        } else {
          for (const needle in jumperChains) {
            if (lower.indexOf(needle) !== -1) {
              kind = 'evm';
              label = needle.charAt(0).toUpperCase() + needle.slice(1);
              break;
            }
          }
        }
      }

      if (!kind || !label) return;
      const banner = document.getElementById('preselect-banner');
      if (!banner) return;
      const esc = (s) => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
      const anchor = kind === 'solana' ? '#solana' : '#evm';
      const ecosystem = kind === 'solana' ? 'Solana' : 'EVM';
      banner.innerHTML =
        '<strong>Detected:</strong> ' + esc(label) + ' (' + ecosystem + '). ' +
        'The <a href="' + anchor + '">' + ecosystem + ' widget</a> below is pre-selected for this token — scroll to swap.';
      banner.hidden = false;
    })();
  </script>

  <style>
    .terminal-host {
      margin: 1.5rem 0;
      min-height: 600px;
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }
    .terminal-fallback {
      padding: 2rem;
      text-align: center;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }
    .lifi-host {
      margin: 1.5rem 0;
      display: flex;
      justify-content: center;
      min-height: 600px;
    }
    .section-alt { background: rgba(217, 212, 196, 0.18); padding: 2rem 0; border-block: 1px solid var(--rule); }
    .muted code { background: #fff; padding: 0.1em 0.4em; border-radius: 3px; border: 1px solid var(--rule); word-break: break-all; }
    .cta {
      display: inline-block;
      background: var(--accent);
      color: #fff !important;
      padding: 0.6rem 1.1rem;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 600;
    }
    .cta:hover { background: var(--warn); text-decoration: none; }
    .micro { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.75rem; }
    .preselect-banner {
      margin: 1rem 0 0;
      padding: 0.75rem 1rem;
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: 4px;
      background: #fff;
      font-size: 0.95rem;
    }
    .preselect-banner .banner-cta {
      display: inline-block;
      margin-left: 0.5rem;
      font-weight: 600;
    }
  </style>
</Base>
