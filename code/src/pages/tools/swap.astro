---
import Base from '../../layouts/Base.astro';
import LifiSwapWidget from '../../components/LifiSwapWidget.tsx';
import {
  EVM_INTEGRATOR_ADDRESS,
  SOL_INTEGRATOR_ADDRESS,
  LIFI_INTEGRATOR_KEY,
  LIFI_FEE_BPS,
  JUPITER_FEE_BPS,
} from '../../lib/integrator.ts';
import { SOLANA_MINTS, SLUG_SWAP_TARGETS, JUMPER_CHAIN_KEYS } from '../../lib/tokens.ts';

const title = 'Swap airdrop tokens — web3-discover';
const description = 'Embedded DEX-aggregator swap. Solana via Jupiter, EVM via LiFi widget. Honest 30 bps (EVM) / 50 bps (Solana) integrator fee disclosed upfront. No KYC, no signup, non-custodial.';
const lifiFeePct = (LIFI_FEE_BPS / 100).toFixed(2);
const jupiterFeePct = (JUPITER_FEE_BPS / 100).toFixed(2);
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <div class="kicker">Tools</div>
      <h1>Swap your airdrop tokens.</h1>
      <p class="lede">
        Non-custodial, no signup, no KYC. Solana swaps route through
        <a href="https://jup.ag" rel="noopener" target="_blank">Jupiter</a>;
        EVM swaps route through the embedded
        <a href="https://li.fi" rel="noopener" target="_blank">LiFi</a> widget
        (the same router that powers <a href="https://jumper.exchange" rel="noopener" target="_blank">jumper.exchange</a>).
        We earn an integrator fee of <strong>{jupiterFeePct}%</strong> (Solana, pending PDA top-up)
        or <strong>{lifiFeePct}%</strong> (EVM, live) on swaps initiated here — disclosed openly,
        baked into the quote you see. See our <a href="/disclosure">affiliate disclosure</a>.
      </p>
      <div id="preselect-banner" class="preselect-banner" hidden></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 id="solana">Solana — Jupiter</h2>
      <p class="muted">
        Best execution across every Solana DEX. Connect Phantom / Solflare / any Solana wallet,
        pick tokens, swap. Our integrator address is baked into the quote:
        <code data-integrator="solana">{SOL_INTEGRATOR_ADDRESS}</code>
      </p>

      <div id="integrated-terminal" class="terminal-host"
        data-integrator-address={SOL_INTEGRATOR_ADDRESS}
        data-integrator-fee-bps={JUPITER_FEE_BPS}>
        <div class="terminal-fallback">Loading Jupiter Plugin…</div>
      </div>

      <p class="micro">
        If the widget doesn't load (script blocked / offline), use
        <a href="https://jup.ag/swap/SOL-USDC" rel="noopener" target="_blank">jup.ag</a> directly —
        same routing, no integrator fee.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 id="evm">EVM — LiFi widget</h2>
      <p class="muted">
        Cross-chain aggregator across Ethereum, Arbitrum, Base, Optimism, Polygon, BSC, +20 more.
        Integrator key <code data-integrator="evm-key">{LIFI_INTEGRATOR_KEY}</code>,
        EVM fee recipient <code data-integrator="evm">{EVM_INTEGRATOR_ADDRESS}</code>.
        Connect any EVM wallet (MetaMask / WalletConnect / Coinbase), pick tokens, swap —
        the <strong>{lifiFeePct}%</strong> integrator fee appears as a line item in the quote
        and is auto-forwarded by LiFi's FeeForwarder contract.
      </p>

      <div class="lifi-host">
        <LifiSwapWidget client:only="react">
          <div slot="fallback" class="terminal-fallback">Loading LiFi widget…</div>
        </LifiSwapWidget>
      </div>

      <p class="micro">
        Prefer the standalone UI? Use <a href="https://jumper.exchange" rel="noopener" target="_blank">jumper.exchange</a> directly —
        same LiFi router under the hood, no integrator fee on that path.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>How the fee works (plain English)</h2>
      <div class="prose">
        <ul>
          <li>
            <strong>Solana swaps via Jupiter:</strong> when fully wired,
            up to <strong>{jupiterFeePct}%</strong> of the swap output is sent to our
            integrator address (<code>{SOL_INTEGRATOR_ADDRESS}</code>) during the swap
            transaction itself. No platform on top of the user — Jupiter's router does it.
            Fee activation requires a Jupiter Referral PDA, which needs a small SOL gas
            top-up; we'll flip it on as soon as the wallet is funded.
          </li>
          <li>
            <strong>EVM swaps via LiFi:</strong> our integrator account
            (key <code>{LIFI_INTEGRATOR_KEY}</code>, EVM recipient <code>{EVM_INTEGRATOR_ADDRESS}</code>)
            is registered with the LiFi Partner Portal — fee dashboard at
            <a href="https://portal.li.fi/integrations" rel="noopener" target="_blank">portal.li.fi/integrations</a>.
            The widget embedded above charges <strong>{lifiFeePct}%</strong> of the
            from-amount, deducted by LiFi's router during the swap transaction itself
            and forwarded to the address above by LiFi's FeeForwarder contract on
            supported chains (Ethereum, Arbitrum, Base, Optimism, Polygon, BSC, +20 more).
            Static jumper.exchange deeplinks earn 0 bps — true of every major EVM
            aggregator — so the widget embed is the only path to fee accrual.
          </li>
          <li>
            <strong>You always see the fee in the quote.</strong> Neither Jupiter nor LiFi
            hides integrator fees — the quote ("you receive X") already nets out the fee.
            If a hidden fee ever appears, that's a bug; email
            <a href="mailto:hello@west0n.top">hello@west0n.top</a> and we'll refund.
          </li>
          <li>
            <strong>Non-custodial.</strong> We never touch your tokens. The transaction is
            signed from your wallet and broadcast directly. Our address only receives the
            small integrator-fee portion.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Jupiter Plugin (successor to Jupiter Terminal v3, which now calls a dead tokens.jup.ag host) -->
  <script
    src="https://plugin.jup.ag/main.js"
    data-preload
    defer
  ></script>
  <script
    is:inline
    type="application/json"
    id="swap-registry"
    set:html={JSON.stringify({
      solanaMints: SOLANA_MINTS,
      slugTargets: SLUG_SWAP_TARGETS,
      jumperChains: JUMPER_CHAIN_KEYS,
      lifiKey: LIFI_INTEGRATOR_KEY,
    })}
  ></script>
  <script is:inline define:vars={{ solIntegrator: SOL_INTEGRATOR_ADDRESS, feeBps: JUPITER_FEE_BPS }}>
    const REGISTRY = (() => {
      try {
        return JSON.parse(document.getElementById('swap-registry').textContent || '{}');
      } catch (err) {
        console.error('[web3-discover] swap registry parse failed:', err);
        return {};
      }
    })();
    const SOLANA_MINTS = REGISTRY.solanaMints || {};
    const SLUG_TARGETS = REGISTRY.slugTargets || {};
    const JUMPER_CHAINS = REGISTRY.jumperChains || {};
    const LIFI_KEY = REGISTRY.lifiKey || '';

    function detectJumperChain(chain) {
      if (!chain) return null;
      const lower = chain.toLowerCase();
      const entries = Object.keys(JUMPER_CHAINS);
      for (let i = 0; i < entries.length; i++) {
        const needle = entries[i];
        if (lower.indexOf(needle) !== -1) {
          return {
            key: JUMPER_CHAINS[needle],
            label: needle.charAt(0).toUpperCase() + needle.slice(1),
          };
        }
      }
      return null;
    }

    function resolveTarget(slug, projectName, chain) {
      if (slug && SLUG_TARGETS[slug]) return SLUG_TARGETS[slug];
      if (projectName) {
        const key = projectName.toUpperCase().trim();
        if (SOLANA_MINTS[key]) {
          return {
            kind: 'solana',
            inputMint: SOLANA_MINTS[key],
            outputMint: SOLANA_MINTS.USDC,
            symbol: key,
          };
        }
      }
      if (chain) {
        if (/\bsolana\b/i.test(chain)) return { kind: 'fallback' };
        const evm = detectJumperChain(chain);
        if (evm) return { kind: 'evm', fromChain: evm.key, chainLabel: evm.label };
      }
      return { kind: 'fallback' };
    }

    const URL_PARAMS = new URLSearchParams(window.location.search);
    const slugParam = URL_PARAMS.get('slug');
    const tokenParam = URL_PARAMS.get('token');
    const chainParam = URL_PARAMS.get('chain');
    const RESOLVED = resolveTarget(slugParam, tokenParam, chainParam);

    // EVM preselect: LiFi React island reads the same registry + URL params and
    // pre-fills its own form. We still surface a banner so the user sees the
    // detected chain above the fold.
    if (RESOLVED.kind === 'evm') {
      const banner = document.getElementById('preselect-banner');
      if (banner) {
        const projectLabel = tokenParam || RESOLVED.tokenLabel || RESOLVED.chainLabel;
        banner.innerHTML =
          '<strong>Detected:</strong> ' + escapeHtml(projectLabel) +
          ' (' + escapeHtml(RESOLVED.chainLabel) + ', EVM). ' +
          'The LiFi widget below is pre-selected for this chain — scroll to swap.';
        banner.hidden = false;
      }
    } else if (RESOLVED.kind === 'solana') {
      const banner = document.getElementById('preselect-banner');
      if (banner) {
        banner.innerHTML =
          '<strong>Detected:</strong> ' + escapeHtml(RESOLVED.symbol) +
          ' (Solana SPL) — Jupiter is pre-selecting it as the input below.';
        banner.hidden = false;
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    }

    function initJupiter(attempts) {
      attempts = attempts || 0;
      if (attempts > 60) {
        const host = document.getElementById('integrated-terminal');
        if (host) {
          host.innerHTML =
            '<p style="padding:1rem;color:#b54a14;">Jupiter Plugin failed to load (network or CDN). ' +
            'Use <a href="https://jup.ag/swap/SOL-USDC" target="_blank" rel="noopener">jup.ag/swap</a> directly — ' +
            'same routing, no integrator fee on that path.</p>';
        }
        return;
      }
      if (typeof window === 'undefined' || !window.Jupiter) {
        setTimeout(function () { initJupiter(attempts + 1); }, 200);
        return;
      }
      try {
        // Default: SOL → USDC (the historical behaviour).
        // ?slug=… / ?token=… : project token becomes the INPUT (selling the airdrop).
        let initialInputMint = SOLANA_MINTS.SOL;
        let initialOutputMint = SOLANA_MINTS.USDC;
        if (RESOLVED.kind === 'solana') {
          initialInputMint = RESOLVED.inputMint;
          initialOutputMint = RESOLVED.outputMint || SOLANA_MINTS.USDC;
        }

        window.Jupiter.init({
          displayMode: 'integrated',
          integratedTargetId: 'integrated-terminal',
          endpoint: 'https://solana-rpc.publicnode.com',
          formProps: {
            initialInputMint: initialInputMint,
            initialOutputMint: initialOutputMint,
          },
          containerStyles: { maxHeight: '700px' },
        });
      } catch (err) {
        console.error('[web3-discover] Jupiter init failed:', err);
        const host = document.getElementById('integrated-terminal');
        if (host) {
          host.innerHTML =
            '<p style="padding:1rem;color:#b54a14;">Jupiter Plugin init error: ' + (err && err.message ? err.message : 'unknown') +
            '. Try <a href="https://jup.ag/swap/SOL-USDC" target="_blank" rel="noopener">jup.ag/swap</a> directly.</p>';
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initJupiter(0); });
    } else {
      initJupiter(0);
    }
  </script>

  <style>
    .terminal-host {
      margin: 1.5rem 0;
      min-height: 600px;
      border: 1px solid var(--rule);
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }
    .terminal-fallback {
      padding: 2rem;
      text-align: center;
      color: var(--ink-soft);
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }
    .lifi-host {
      margin: 1.5rem 0;
      display: flex;
      justify-content: center;
      min-height: 600px;
    }
    .section-alt { background: rgba(217, 212, 196, 0.18); padding: 2rem 0; border-block: 1px solid var(--rule); }
    .muted code { background: #fff; padding: 0.1em 0.4em; border-radius: 3px; border: 1px solid var(--rule); word-break: break-all; }
    .cta {
      display: inline-block;
      background: var(--accent);
      color: #fff !important;
      padding: 0.6rem 1.1rem;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 600;
    }
    .cta:hover { background: var(--warn); text-decoration: none; }
    .micro { font-size: 0.85rem; color: var(--ink-soft); margin-top: 0.75rem; }
    .preselect-banner {
      margin: 1rem 0 0;
      padding: 0.75rem 1rem;
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: 4px;
      background: #fff;
      font-size: 0.95rem;
    }
    .preselect-banner .banner-cta {
      display: inline-block;
      margin-left: 0.5rem;
      font-weight: 600;
    }
  </style>
</Base>
