---
import Base from '../../layouts/Base.astro';
import { listPublishedAirdrops } from '../../lib/airdrops.ts';

const entries = await listPublishedAirdrops();
const title = 'Tools — wallet-aware airdrop utilities';
const description = `Four client-side, non-custodial tools paired with our ${entries.length} curated airdrop entries: wallet activity matching, token-holdings checking, integrator-fee DEX swap, and a calendar-subscribable deadline feed.`;
---
<Base title={title} description={description}>
  <section class="hero">
    <div class="container">
      <div class="kicker">Tools</div>
      <h1>Wallet-aware tools.</h1>
      <p class="lede">
        Three browser-only tools (never see your address, never custody, never
        ask you to sign) plus one subscribe-and-forget calendar feed. Paste,
        get an answer, leave — or subscribe once and let deadlines come to you.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="tools-grid">
        <a class="tool-card" href="/tools/wallet-check">
          <div class="tool-kicker">Activity match</div>
          <h2>Wallet check</h2>
          <p>
            Paste an address, see which of our {entries.length} curated airdrops the
            wallet might qualify for. Fans out across 7 chains (Ethereum, Base, Linea,
            Arbitrum, Polygon, BSC, Solana) and surfaces every listing that touches a
            chain you've used.
          </p>
          <span class="tool-cta">Try wallet-check →</span>
        </a>

        <a class="tool-card" href="/tools/token-holdings">
          <div class="tool-kicker">Token balances</div>
          <h2>Token holdings</h2>
          <p>
            Paste an address, see which airdrop-distributed tokens are already in
            this wallet. Covers PYTH, JTO, JUP, W on Solana; ETHFI, PENDLE, ENA, STRK,
            ARB, POL on EVM. Find out if you ever claimed last year's drops.
          </p>
          <span class="tool-cta">Try token-holdings →</span>
        </a>

        <a class="tool-card" href="/tools/swap">
          <div class="tool-kicker">Exit liquidity</div>
          <h2>Swap</h2>
          <p>
            Non-custodial, no signup, no KYC. Solana swaps via Jupiter, EVM via
            Jumper/LiFi. Honest integrator fee (30–50 bps) disclosed upfront.
            Pre-selects the right token when you land here from a listing.
          </p>
          <span class="tool-cta">Open swap →</span>
        </a>

        <a class="tool-card" href="/tools/calendar">
          <div class="tool-kicker">Deadline reminders</div>
          <h2>Calendar</h2>
          <p>
            Subscribe once in Google / Apple / Outlook. Every TGE, snapshot,
            unlock, and season-end milestone from the directory gets pushed
            into the calendar you already check. Plus a weekly Sunday review
            reminder.
          </p>
          <span class="tool-cta">Subscribe →</span>
        </a>

        <a class="tool-card" href="/data">
          <div class="tool-kicker">Open data</div>
          <h2>JSON API</h2>
          <p>
            The full directory as one CORS-open, CC0-licensed JSON endpoint.
            <code>curl /api/airdrops.json</code> — no auth, no rate limit.
            Mirrored to <code>SolvoHQ/web3-discover-data</code> on GitHub for
            scrapers, embeds, and downstream builders.
          </p>
          <span class="tool-cta">See the data →</span>
        </a>
      </div>

      <p class="tools-foot">
        Or just browse the directory: <a href="/airdrops"><strong>{entries.length} curated airdrops →</strong></a>
      </p>
    </div>
  </section>

  <section class="section mcp-section">
    <div class="container">
      <div class="kicker">For LLM users</div>
      <h2 class="mcp-h">Pipe this directory into Claude, Cursor, or any MCP client.</h2>
      <p class="mcp-lede">
        One config line and your LLM can answer
        <em>"what airdrops am I eligible for?"</em>
        with our {entries.length} curated entries — including a server-side wallet matcher
        across 7 chains. JSON-RPC 2.0 over HTTP. No auth, no rate limit, CORS-open.
      </p>

      <p class="mcp-config-label">Claude Desktop / Cursor config:</p>
      <pre class="mcp-config"><code>{`{
  "mcpServers": {
    "web3-discover": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://web3-discover.vercel.app/api/mcp"]
    }
  }
}`}</code></pre>

      <p class="mcp-foot">
        Or curl it directly:
        <a href="/api/mcp"><code>GET /api/mcp</code></a> for the schema,
        <code>POST /api/mcp</code> for JSON-RPC tool calls.
        Full crawler-friendly index at <a href="/llms.txt"><code>/llms.txt</code></a>.
      </p>
    </div>
  </section>

  <style>
    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
      margin: 0.5rem 0 1.5rem;
    }
    .tool-card {
      display: block;
      padding: 1.25rem 1.25rem 1.1rem;
      background: #fff;
      border: 1px solid var(--rule);
      border-radius: 6px;
      color: inherit;
      text-decoration: none;
      transition: border-color 120ms ease, transform 120ms ease;
    }
    .tool-card:hover {
      border-color: var(--accent);
      transform: translateY(-2px);
    }
    .tool-kicker {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-soft);
      margin-bottom: 0.4rem;
    }
    .tool-card h2 {
      margin: 0.1rem 0 0.5rem;
      font-family: var(--font-serif);
      font-size: 1.45rem;
    }
    .tool-card p { margin: 0 0 0.85rem; font-size: 0.95rem; }
    .tool-cta {
      font-weight: 600;
      color: var(--accent);
      font-size: 0.95rem;
    }
    .tools-foot { margin-top: 1rem; font-size: 0.95rem; }

    .mcp-section { border-top: 1px solid var(--rule); }
    .mcp-h {
      margin: 0.2rem 0 0.5rem;
      font-family: var(--font-serif);
      font-size: 1.6rem;
    }
    .mcp-lede { margin: 0 0 1rem; max-width: 60ch; }
    .mcp-config-label {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-soft);
      margin: 0.5rem 0 0.4rem;
    }
    .mcp-config {
      background: #0e0f12;
      color: #e6e6e6;
      padding: 1rem 1.1rem;
      border-radius: 6px;
      font-size: 0.85rem;
      overflow-x: auto;
      margin: 0 0 1rem;
    }
    .mcp-config code { font-family: var(--font-mono); }
    .mcp-foot { font-size: 0.95rem; color: var(--ink-soft); }
    .mcp-foot code { font-family: var(--font-mono); font-size: 0.85rem; }
  </style>
</Base>
