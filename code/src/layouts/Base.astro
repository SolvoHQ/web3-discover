---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogType = 'website', ogImage, extraJsonLd } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pathTrim = Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = canonical ?? (pathTrim ? `${siteUrl}${pathTrim}` : siteUrl);
const ogImageUrl = ogImage ?? `${siteUrl}/og-default.png`;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'web3-discover',
  url: siteUrl,
  logo: `${siteUrl}/og-default.png`,
  description: "The airdrop hunter's honest map. Hand-vetted, scam-filtered web3 airdrop directory.",
  sameAs: [] as string[],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'web3-discover',
  url: siteUrl,
  description,
};

const extraJsonLdArray = Array.isArray(extraJsonLd) ? extraJsonLd : extraJsonLd ? [extraJsonLd] : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="web3-discover" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="web3-discover — the airdrop hunter's honest map" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="robots" content="index,follow" />
    <link rel="alternate" type="application/rss+xml" title="web3-discover — active airdrops" href={`${siteUrl}/rss.xml`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f7f5ef'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='22' font-weight='700' text-anchor='middle' fill='%23c8531a'%3Ew%3C/text%3E%3C/svg%3E" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {extraJsonLdArray.map((blob) => (
      <script type="application/ld+json" set:html={JSON.stringify(blob)} />
    ))}
    <script
      data-goatcounter="https://web3discover.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.js"
    ></script>
  </head>
  <body>
    <header class="masthead">
      <div class="container masthead-inner">
        <a class="brand" href="/">web3-discover<span class="dot">.</span></a>
        <nav class="nav">
          <a href="/airdrops">Airdrops</a>
          <a href="/tools">Tools</a>
          <a href="/guides">Guides</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <p><strong>web3-discover</strong> — the airdrop hunter's honest map. Hand-vetted, scam-filtered, no paid placements pretending to be listings.</p>
        <p>Listings are informational, not financial advice. Verify every official link before acting.</p>
        <p class="footer-nav">
          <a href="/airdrops">Airdrops</a> &middot;
          <a href="/tools">Tools</a> &middot;
          <a href="/guides">Guides</a> &middot;
          <a href="/about">About</a> &middot;
          <a href="/sponsor">Sponsor</a> &middot;
          <a href="/disclosure">Affiliate disclosure</a>
        </p>
      </div>
    </footer>
  </body>
</html>
